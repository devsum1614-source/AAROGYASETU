# AAROGYASETU (आरोग्यसेतु) — Milestone 1 Environment Configuration
# Copy this file to .env and adjust values as needed for local development.
# Fictional data only — Not for production clinical use.

AAROGYASETU_SECRET_KEY=aarogyasetu-karavali-hackathon-dev-secret-2026
AAROGYASETU_DB_PATH=backend/aarogyasetu_m1.db
AAROGYASETU_PRIVATE_STORAGE_DIR=backend/private_reports
AAROGYASETU_MAX_UPLOAD_MB=5
AAROGYASETU_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
VITE_API_BASE_URL=http://localhost:8000

# Allowed Email Domains (Set "*" for any valid domain including Gmail, or comma-separated e.g. "kit.edu.in,karavali.edu.in")
AAROGYASETU_ALLOWED_EMAIL_DOMAINS=*

# Rate limiting / failed login lockout
AAROGYASETU_MAX_FAILED_LOGINS=5
AAROGYASETU_LOGIN_LOCKOUT_SECONDS=600
